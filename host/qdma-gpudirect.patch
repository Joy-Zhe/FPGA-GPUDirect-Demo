--- a/QDMA/linux-kernel/driver/src/cdev.c
+++ b/QDMA/linux-kernel/driver/src/cdev.c
@@ -23,6 +23,7 @@
 
 #include <asm/cacheflush.h>
 #include <linux/device.h>
