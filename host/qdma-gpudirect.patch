 #include <linux/errno.h>
 #include <linux/fs.h>
 #include <linux/kernel.h>
@@ -76,6 +77,16 @@ enum qdma_cdev_ioctl_cmd {
 	QDMA_CDEV_IOCTL_CMDS
 };
 
+#define QDMA_GPU_F_DDR_TO_GPU (1U << 0)
+struct qdma_gpu_xfer {
+	__u32 flags;
+	__u64 gpu_address;
+	__u64 ddr_offset;
+	__u64 length;
+	__u64 transferred;
+};
+#define QDMA_IOCTL_GPU_P2P_XFER _IOWR('q', 0xf1, struct qdma_gpu_xfer)
+
 static struct class *qdma_class;
 static struct kmem_cache *cdev_cache;
 
@@ -215,6 +226,127 @@ static loff_t cdev_gen_llseek(struct file *file, loff_t off, int whence)
 	return newpos;
 }
 
+static long cdev_gpu_p2p_xfer(struct qdma_cdev *xcdev,
+				unsigned long arg)
+{
+	struct qdma_gpu_xfer ux;
+	nvidia_p2p_page_table_t *page_table = NULL;
+	nvidia_p2p_dma_mapping_t *dma_mapping = NULL;
+	struct qdma_sw_sg *qsg, *cur;
+	struct qdma_request req = { 0 };
+	u64 left;
+	u64 page_bytes;
+	unsigned int i, nents;
+	unsigned int sgcnt;
+	unsigned long qhndl;
+	ssize_t rv;
+	bool write;
+
+	if (copy_from_user(&ux, (void __user *)arg, sizeof(ux)))
+		return -EFAULT;
+	if (ux.flags & ~QDMA_GPU_F_DDR_TO_GPU)
+		return -EINVAL;
+	if (!ux.length || ux.length > UINT_MAX ||
+	    ux.gpu_address & ((1ULL << 16) - 1) ||
+	    ux.length & ((1ULL << 16) - 1) ||
+	    ux.ddr_offset >= (1ULL << 33) ||
+	    ux.length > (1ULL << 33) - ux.ddr_offset)
+		return -EINVAL;
+
+	write = !(ux.flags & QDMA_GPU_F_DDR_TO_GPU);
+	rv = nvidia_p2p_get_pages_persistent(ux.gpu_address, ux.length,
+					&page_table, NVIDIA_P2P_FLAGS_DEFAULT);
+	if (rv) {
+		pr_err("%s: nvidia_p2p_get_pages_persistent failed: %zd\n",
+			xcdev->name, rv);
+		goto out;
+	}
+	rv = nvidia_p2p_dma_map_pages(xcdev->xcb->xpdev->pdev,
+					page_table, &dma_mapping);
+	if (rv) {
+		pr_err("%s: nvidia_p2p_dma_map_pages failed: %zd\n",
+			xcdev->name, rv);
+		goto out_put_pages;
+	}
+	if (!NVIDIA_P2P_DMA_MAPPING_VERSION_COMPATIBLE(dma_mapping)) {
+		pr_err("%s: incompatible NVIDIA DMA mapping version 0x%x\n",
+			xcdev->name, dma_mapping->version);
+		rv = -EINVAL;
+		goto out_unmap_pages;
+	}
+	if (dma_mapping->page_size_type == NVIDIA_P2P_PAGE_SIZE_64KB)
+		page_bytes = 1ULL << 16;
+	else if (dma_mapping->page_size_type == NVIDIA_P2P_PAGE_SIZE_128KB)
+		page_bytes = 1ULL << 17;
+	else {
+		pr_err("%s: unsupported NVIDIA P2P page-size type %u\n",
+			xcdev->name, dma_mapping->page_size_type);
+		rv = -EINVAL;
+		goto out_unmap_pages;
+	}
+	nents = dma_mapping->entries;
+	if (!nents || nents > 65535) {
+		pr_err("%s: invalid NVIDIA P2P entry count %u\n",
+			xcdev->name, nents);
+		rv = -EINVAL;
+		goto out_unmap_pages;
+	}
+	qsg = kcalloc(nents, sizeof(*qsg), GFP_KERNEL);
+	if (!qsg) {
+		rv = -ENOMEM;
+		goto out_unmap_pages;
+	}
+	left = ux.length;
+	cur = qsg;
+	for (i = 0; i < nents && left; ++i) {
+		cur->dma_addr = dma_mapping->dma_addresses[i];
+		cur->len = min_t(u64, left, page_bytes);
+		cur->next = (left == cur->len) ? NULL : cur + 1;
+		left -= cur->len;
+		cur++;
+	}
+	if (left) {
+		pr_err("%s: NVIDIA P2P mapping is %llu bytes short\n",
+			xcdev->name, left);
+		rv = -EINVAL;
+		goto out_free;
+	}
+	sgcnt = cur - qsg;
+
+	qhndl = write ? xcdev->h2c_qhndl : xcdev->c2h_qhndl;
+	if (!qhndl) {
+		rv = -ENODEV;
+		goto out_free;
+	}
+	req.sgl = qsg;
+	req.sgcnt = sgcnt;
+	req.write = write;
+	req.dma_mapped = 1;
+	req.ep_addr = ux.ddr_offset;
+	req.count = ux.length;
+	req.timeout_ms = 30000;
+	req.h2c_eot = 1;
+	rv = xcdev->fp_rw(xcdev->xcb->xpdev->dev_hndl, qhndl, &req);
+	if (rv >= 0) {
+		ux.transferred = rv;
+		rv = copy_to_user((void __user *)arg, &ux, sizeof(ux)) ? -EFAULT : 0;
+	}
+out_free:
+	kfree(qsg);
+out_unmap_pages:
+	if (dma_mapping) {
+		nvidia_p2p_dma_unmap_pages(xcdev->xcb->xpdev->pdev, page_table,
+						dma_mapping);
+	}
+out_put_pages:
+	if (page_table) {
+		nvidia_p2p_put_pages_persistent(ux.gpu_address, page_table,
+						NVIDIA_P2P_FLAGS_DEFAULT);
+	}
+out:
+	return rv;
+}
+
 static long cdev_gen_ioctl(struct file *file, unsigned int cmd,
 			unsigned long arg)
 {
@@ -224,8 +356,9 @@ static long cdev_gen_ioctl(struct file *file, unsigned int cmd,
 	case QDMA_CDEV_IOCTL_NO_MEMCPY:
 		get_user(xcdev->no_memcpy, (unsigned char *)arg);
 		return 0;
-	default:
-		break;
+	case QDMA_IOCTL_GPU_P2P_XFER:
+		return cdev_gpu_p2p_xfer(xcdev, arg);
+	default:		break;
 	}
 	if (xcdev->fp_ioctl_extra)
 		return xcdev->fp_ioctl_extra(xcdev, cmd, arg);

